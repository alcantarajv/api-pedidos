# Copie para .env e ajuste. O arquivo .env esta no .gitignore e nunca deve ser
# commitado. Este projeto lida com pagamento: as chaves do gateway entram aqui
# nas proximas etapas e nao podem, em nenhuma hipotese, ir para o repositorio.

# --- Banco ---
DB_URL=jdbc:postgresql://localhost:5432/pedidos
DB_USERNAME=pedidos
DB_PASSWORD=pedidos

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=pedidos
RABBITMQ_PASSWORD=pedidos

# --- JWT ---
# Minimo de 32 caracteres (256 bits) para HS256. A aplicacao se recusa a subir
# com um segredo menor. Gere um valor aleatorio, nao use este texto.
JWT_SECRET=troque-por-um-segredo-longo-de-no-minimo-32-caracteres
JWT_EXPIRACAO_MINUTOS=120

# --- Admin inicial (opcional) ---
# Se definidos, criam um usuario ADMIN no primeiro boot. Sem eles, nada acontece.
# O registro publico so cria CLIENTE, entao este e o unico caminho para o
# primeiro administrador. Depois do primeiro acesso, troque a senha e remova
# estas variaveis.
ADMIN_INICIAL_NOME=Administrador
ADMIN_INICIAL_EMAIL=admin@pedidos.dev
ADMIN_INICIAL_SENHA=troque-esta-senha

# --- Gateway de pagamento (Stripe em modo de teste) ---
# Chave secreta da conta: comeca com sk_test_ no ambiente de testes. NUNCA use
# a chave de producao aqui, e nunca commite este valor.
STRIPE_API_KEY=sk_test_coloque_a_sua_chave_de_teste
GATEWAY_URL=https://api.stripe.com
